# --- Обязательно -----------------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Твой Telegram user id (узнать у @userinfobot)
TELEGRAM_OWNER_ID=

# --- Система ---------------------------------------------------------------
WAKE_ANCHOR=07:00
WAKE_TOLERANCE_MIN=60
STEPS_FLOOR=4000
STEPS_GOAL=7000
EVENING_AT=21:00
WEEKLY_AT=20:00
DEFAULT_TZ=Asia/Almaty

# --- Данные о здоровье -----------------------------------------------------
# file (Mac, iCloud Drive) | http (Fly.io)
HEALTH_SOURCE=file
HEALTH_FILE="~/Library/Mobile Documents/com~apple~CloudDocs/Floor/health.json"
# Только для http. Токен: openssl rand -hex 32
HTTP_ADDR=:8080
INGEST_TOKEN=

# --- Хранилище и Claude ----------------------------------------------------
DB_PATH=~/.floor/floor.db
CLAUDE_BIN=claude
LLM_TIMEOUT=90s
LLM_MAX_CALLS_PER_DAY=30
LOG_LEVEL=info
