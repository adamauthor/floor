# --- Обязательно -----------------------------------------------------------
# Токен бота от @BotFather
TELEGRAM_TOKEN=
# Твой Telegram user id (узнать у @userinfobot)
TELEGRAM_OWNER_ID=

# --- Система ---------------------------------------------------------------
WAKE_ANCHOR=07:00
WAKE_TOLERANCE_MIN=60
STEPS_FLOOR=7000
STEPS_GOAL=10000
EVENING_AT=21:00
WEEKLY_AT=20:00
DEFAULT_TZ=Asia/Almaty

# Привычки и якоря: создаётся при первом запуске, правится руками (docs/HABITS.md)
HABITS_FILE=~/.floor/habits.json
# Страница настроек (Telegram Mini App). Подъём, шаги и время из неё перекрывают значения выше
WEBAPP_URL=https://adamauthor.github.io/floor/app/

# --- Данные о здоровье -----------------------------------------------------
# google (Fitbit через Google Health API, docs/GOOGLE_HEALTH.md)
# | file (Команда iPhone → iCloud Drive) | http (Fly.io)
HEALTH_SOURCE=google
# Только для google: OAuth-клиент типа «Desktop app»; вход — floor google-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_FILE=~/.floor/google-token.json
GOOGLE_POLL=15m
# Только для file
HEALTH_FILE="~/Library/Mobile Documents/com~apple~CloudDocs/Floor/health.json"
# Только для http. Токен: openssl rand -hex 32
HTTP_ADDR=:8080
INGEST_TOKEN=

# --- Хранилище и Claude ----------------------------------------------------
DB_PATH=~/.floor/floor.db
CLAUDE_BIN=claude
LLM_TIMEOUT=90s
LLM_MAX_CALLS_PER_DAY=30
LOG_LEVEL=info
